{
	"name": "sn-edit",
	"displayName": "sn-edit",
	"description": "Servicenow Script Editor Engine (sn-edit.com)",
	"publisher": "snedit",
	"version": "0.0.1",
	"repository": "https://github.com/sn-edit/vscode",
	"engines": {
		"vscode": "^1.44.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"*",
		"onCommand:sn-edit.download",
		"onCommand:sn-edit.version",
		"onCommand:snedit.changeUpdateSet"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "sn-edit.download",
				"title": "sn-edit Download Script"
			},
			{
				"command": "sn-edit.version",
				"title": "sn-edit Version"
			}
		]
	},
	"scripts": {
		"lint": "eslint .",
		"pretest": "npm run lint",
		"test": "node ./test/runTest.js"
	},
	"devDependencies": {
		"@types/vscode": "^1.44.0",
		"@types/glob": "^7.1.1",
		"@types/mocha": "^7.0.2",
		"@types/node": "^13.11.0",
		"eslint": "^6.8.0",
		"glob": "^7.1.6",
		"mocha": "^7.1.1",
		"typescript": "^3.8.3",
		"vscode-test": "^1.3.0"
	},
	"dependencies": {
		"curlrequest": "^1.0.1",
		"js-yaml": "^3.13.1",
		"shelljs": "^0.8.4"
	}
}
